# ---- App ----
NODE_ENV=development
PORT=3000

# ---- Database (PostgreSQL) ----
# Matches docker-compose.yml defaults for local dev.
DATABASE_URL=postgresql://calsync:calsync@localhost:5432/calsync?schema=public

# ---- Redis (BullMQ queues, locks, rate-limit buckets) ----
REDIS_URL=redis://localhost:6379

# ---- Nylas (unified calendar aggregator) ----
# Create a sandbox application at https://dashboard-v3.nylas.com/
NYLAS_API_KEY=
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_CLIENT_ID=
# Secret used to verify inbound webhook HMAC signatures (X-Nylas-Signature).
NYLAS_WEBHOOK_SECRET=

# ---- Sync engine tuning ----
# Backfill window on new link creation (days before / after now).
BACKFILL_DAYS_PAST=30
BACKFILL_DAYS_FUTURE=180
# Per-connected-account write rate limit (requests per second).
PROVIDER_RATE_LIMIT_RPS=5
